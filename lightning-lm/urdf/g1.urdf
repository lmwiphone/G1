<?xml version="1.0"?>
<robot name="g1_navigation_sensors">

  <!--
    Planar navigation frame.
    base_link is the robot rotation center projected onto the ground.
  -->
  <link name="base_link"/>

  <link name="base_footprint"/>

  <joint name="base_to_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- MID360 -->
  <link name="mid360_link"/>

  <joint name="base_to_mid360_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid360_link"/>

    <!--
      MID360 height relative to the planar ground navigation frame.
      LiDAR inversion is already handled in the driver.

      pitch = -2.3 deg = -0.04014257279586953 rad。
      Unitree 官方外参文档明确：Mid360 在 G1 上采用【倒置】安装，
      pitch 轴倾角为 -2.3°，yaw 与 roll 无倾斜。
      2026-09-17 之前这里写成 +0.04014（正号），导致 map->base_link 整体
      俯仰倾斜约 2 倍该角度。
    -->
    <origin
      xyz="0.0002835 0.00003 1.23618"
      rpy="0 -0.04014257279586953 0"/>
  </joint>

  <!-- d435 -->
  <link name="d435_link"/>

  <joint name="base_to_d435_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435_link"/>
    <origin xyz="0.0576235 0.01753 1.24987" rpy="0 0.8307767239493009 0"/>
  </joint>

  <!--
    realsense2_camera with camera_name:=camera publishes its internal TF tree
    below camera_link.  d435_link is the calibrated mounting frame and is
    intentionally coincident with the driver's camera_link.
  -->
  <link name="camera_link"/>

  <joint name="d435_to_camera_link_joint" type="fixed">
    <parent link="d435_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- MID360 internal IMU -->
  <link name="mid360_imu"/>

  <joint name="mid360_to_imu_joint" type="fixed">
    <parent link="mid360_link"/>
    <child link="mid360_imu"/>

    <origin
      xyz="0.011 0.02329 -0.04412"
      rpy="0 0 0"/>
  </joint>

</robot>